<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or metadata.title }}</title>
  <meta name="description" content="{{ description or metadata.description }}">
  <link rel="stylesheet" href="{{ "/css/main.css" | urlize }}">
  <link rel="stylesheet" href="{{ "/css/prism.ghcolors.css" | urlize }}">
  {% set isPost = tags and 'post' in tags %}
  {% set socialImage = "https://bnb.im/img/social/" + page.fileSlug + ".png" if isPost else "https://bnb.im/img/small-card.png" %}
  <meta name="twitter:card" content="{{ 'summary_large_image' if isPost else 'summary' }}" />
  <meta name="twitter:creator" content="@bitandbang" />
  <meta property="og:url" content="https://bnb.im{{page.url}}" />
  <meta property="og:title" content="{{ title or metadata.title }}" />
  <meta property="og:description" content="{{ description or metadata.description }}" />
  <meta name="twitter:image" content="{{ socialImage }}" />
  <meta property="og:image" content="{{ socialImage }}" />
  {% if isPost %}
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {% endif %}
  <link rel="alternate" title="Tierney Cyren - Software and Selected Garbage" type="application/atom+xml" href="https://bnb.im/feed.xml">
</head>
<body class="sans">
  <header class="global">
    <section class="container">
      <section class=grow-4>
        <a href="{{ "/" | urlize}}"><h1 class="serif">Tierney Cyren</h1></a>
      </section>
      <nav>
        <a href="https://bsky.app/profile/bnb.im" class="p-l-1rem sans">Bluesky</a>
        <a href="https://github.com/bnb" class="p-l-1rem sans">GitHub</a>
        <a href="https://instagram.com/bitandbang" class="p-l-1rem sans">Instagram</a>
      </nav>
    </section>
  </header>
  <section>
    {{ content | safe}}
  </section>
  <footer>
    <p class="smiley">:)</p>
  </footer>
</body>
</html>